<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>CiderPress II</string>
    <key>CFBundleDisplayName</key>
    <string>CiderPress II</string>
    <key>CFBundleIdentifier</key>
    <string>com.lydianscale.ciderpress2</string>
    <key>CFBundleVersion</key>
    <string>1.2.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.2.0</string>
    <key>CFBundleExecutable</key>
    <string>CiderPress2</string>
    <key>CFBundleIconFile</key>
    <string>cp2_app</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright 2026 Lydian Scale Software</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <!-- Formats that are, for all practical purposes, exclusive to CiderPress II/Apple II
             tools; claim ownership so Finder offers us by default (drag onto Dock icon,
             "Open With", double-click). Deliberately excludes ".app" (macOS application
             bundles) even though the cp2 tools recognize it as a disk-image extension on
             other platforms -- claiming it here would make Finder think every Mac app is a
             CiderPress II document. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Apple II Disk Image or Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>dsk</string>
                <string>po</string>
                <string>do</string>
                <string>d13</string>
                <string>2mg</string>
                <string>2img</string>
                <string>hdv</string>
                <string>dc</string>
                <string>dc42</string>
                <string>dc6</string>
                <string>image</string>
                <string>ddd</string>
                <string>nib</string>
                <string>nb2</string>
                <string>woz</string>
                <string>moof</string>
                <string>shk</string>
                <string>sdk</string>
                <string>bny</string>
                <string>bqy</string>
                <string>bxy</string>
                <string>bse</string>
                <string>as</string>
                <string>macbin</string>
                <string>acu</string>
            </array>
        </dict>
        <!-- Formats CiderPress II understands but that other, more common apps also own
             (zip/gzip archives, WAV audio, StuffIt/self-extracting archives, generic
             binary data, raw/ISO CD images). Registered as "Alternate" so CiderPress II
             shows up in "Open With" without taking over the user's existing default
             handler or outranking it for double-click/drag-onto-icon. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Generic Archive or Disk Image Format</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>zip</string>
                <string>gz</string>
                <string>sit</string>
                <string>sea</string>
                <string>bin</string>
                <string>wav</string>
                <string>img</string>
                <string>iso</string>
                <string>raw</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
